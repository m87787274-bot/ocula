{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "analyst", "viewer"] },
        "account": { "type": "object" },
        "avatar": { "type": "string" },
        "businessDetails": { "type": "object" }
      },
      "required": ["id", "name", "email", "role", "account"]
    },
    "SavedScan": {
      "title": "Saved Scan",
      "description": "Saved visibility reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "businessName": { "type": "string" },
        "score": { "type": "number" },
        "report": { "type": "object" }
      },
      "required": ["id", "userId", "timestamp", "businessName", "score", "report"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Intelligence signals and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error", "anomaly"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "link": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "timestamp", "read"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Business growth campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "planned", "completed"] },
        "progress": { "type": "number" },
        "objective": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "deadline": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "status", "progress", "objective", "priority"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "Customer support requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/scans/{scanId}": {
      "schema": "SavedScan",
      "description": "User's visibility scans"
    },
    "users/{userId}/notifications/{notifId}": {
      "schema": "Notification",
      "description": "User's intelligence notifications"
    },
    "users/{userId}/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "User's growth campaigns"
    },
    "users/{userId}/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User's support tickets"
    }
  }
}
